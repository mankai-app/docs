---
interface Props {
  stableLabel: string
  nightlyLabel: string
  stableDownloadLabel: string
  nightlyDownloadLabel: string
}

const { stableLabel, nightlyLabel, stableDownloadLabel, nightlyDownloadLabel } =
  Astro.props
const releases = 'https://github.com/mankai-app/mankai/releases'
const altDirect = 'https://altdirect.app'
const sourceBadge = `${altDirect}/assets/png/AltSource_Blue.png`
const downloadBadge = `${altDirect}/assets/png/Download_Blue.png`

const links = [
  {
    href: `${altDirect}/?url=${encodeURIComponent(`${releases}/download/nightly/altstore-stable.json`)}`,
    badge: sourceBadge,
    label: stableLabel,
  },
  {
    href: `${altDirect}/?url=${encodeURIComponent(`${releases}/download/nightly/altstore-nightly.json`)}`,
    badge: sourceBadge,
    label: nightlyLabel,
  },
  {
    href: `${releases}/latest/download/mankai.ipa`,
    badge: downloadBadge,
    label: stableDownloadLabel,
  },
  {
    href: `${releases}/download/nightly/mankai.ipa`,
    badge: downloadBadge,
    label: nightlyDownloadLabel,
  },
]
---

<ul class="sideload-links" role="list">
  {links.map(({ href, badge, label }) => (
    <li>
      <a href={href}>
        <img src={badge} alt="" width="200" />
        <span>{label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .sideload-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 200px));
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .sideload-links li {
    margin: 0;
  }

  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
  }

  img,
  span {
    margin: 0;
  }

  img {
    max-width: 100%;
    height: auto;
  }
</style>
